{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/ever-works/directory-registry/main/registry.schema.json",
	"title": "Ever Works Directory Registry v1",
	"type": "object",
	"required": ["version", "directories"],
	"properties": {
		"$schema": { "type": "string" },
		"version": { "const": 1 },
		"name": { "type": "string", "maxLength": 200 },
		"directories": {
			"type": "array",
			"maxItems": 400,
			"items": {
				"type": "object",
				"required": ["id", "url"],
				"properties": {
					"id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
					"url": { "type": "string", "pattern": "^https://[^/@?#]+/?$" },
					"name": { "type": "string", "maxLength": 200 },
					"description": { "type": "string", "maxLength": 2000 },
					"topics": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
					"aliases": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
					"listed": { "type": "boolean" }
				},
				"additionalProperties": false
			}
		}
	},
	"additionalProperties": false
}
